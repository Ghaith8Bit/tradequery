{"id": "sm-01", "category": "smart", "source": "news-04", "question": "Did news cause my worst drawdown?", "gold": {"entity": "drawdown_episodes", "fields": ["depth_abs", "news_loss_share"], "filters": [{"field": "basis", "op": "eq", "value": "balance"}], "order_by": [{"field": "depth_abs", "direction": "desc"}], "limit": 1}}
{"id": "sm-02", "category": "smart", "source": "dd-01", "question": "What was my worst drawdown, and what was it made of?", "gold": {"entity": "drawdown_episodes", "fields": ["depth_abs", "trade_count"], "filters": [{"field": "basis", "op": "eq", "value": "balance"}], "order_by": [{"field": "depth_abs", "direction": "desc"}], "limit": 1}}
{"id": "sm-03", "category": "smart", "source": "dd-03", "question": "How long did my worst drawdown last?", "gold": {"entity": "drawdown_episodes", "fields": ["duration_days"], "filters": [{"field": "basis", "op": "eq", "value": "balance"}], "order_by": [{"field": "depth_abs", "direction": "desc"}], "limit": 1}}
{"id": "sm-04", "category": "smart", "source": "metric-07", "question": "What was my longest losing streak, and what went wrong in it?", "gold": {"entity": "trades", "metrics": ["max_loss_streak"]}}
{"id": "sm-05", "category": "smart", "source": "group-01", "question": "Which hour of the day loses me the most money on gold?", "gold": {"entity": "trades", "filters": [{"field": "canonical_symbol", "op": "eq", "value": "XAUUSD"}], "group_by": ["hour"], "aggregations": [{"func": "sum", "field": "net_profit", "alias": "net"}], "order_by": [{"field": "net", "direction": "asc"}], "limit": 1}}
{"id": "sm-06", "category": "smart", "source": "ho-group-01", "question": "Which symbol made me the least money, and why?", "gold": {"entity": "trades", "group_by": ["canonical_symbol"], "aggregations": [{"func": "sum", "field": "net_profit", "alias": "net"}], "order_by": [{"field": "net", "direction": "asc"}], "limit": 1}}
{"id": "sm-07", "category": "smart", "source": "ho-group-06", "question": "In which trading session did I lose the most?", "gold": {"entity": "trades", "group_by": ["session"], "aggregations": [{"func": "sum", "field": "net_profit", "alias": "net"}], "order_by": [{"field": "net", "direction": "asc"}], "limit": 1}}
{"id": "sm-08", "category": "smart", "source": "group-03", "question": "Which weekday is my most profitable?", "gold": {"entity": "trades", "group_by": ["weekday"], "aggregations": [{"func": "sum", "field": "net_profit", "alias": "net"}], "order_by": [{"field": "net", "direction": "desc"}], "limit": 1}}
{"id": "sm-09", "category": "smart", "source": "group-09", "question": "What was my single best trade?", "gold": {"entity": "trades", "fields": ["position_id", "net_profit"], "order_by": [{"field": "net_profit", "direction": "desc"}], "limit": 1}}
{"id": "sm-10", "category": "smart", "source": "group-10", "question": "Show my three worst trades, worst first.", "gold": {"entity": "trades", "fields": ["position_id", "net_profit"], "order_by": [{"field": "net_profit", "direction": "asc"}], "limit": 3}}
{"id": "sm-11", "category": "smart", "source": "seq-02", "question": "What was my deepest martingale basket and how did it end?", "gold": {"entity": "sequences", "fields": ["sequence_id", "depth", "net_pnl"], "filters": [{"field": "type", "op": "in", "value": ["martingale", "martingale_grid"]}], "order_by": [{"field": "depth", "direction": "desc"}], "limit": 1}}
{"id": "sm-12", "category": "smart", "source": "ho-seq-02", "question": "Which basket lost me the most money?", "gold": {"entity": "sequences", "fields": ["sequence_id", "net_pnl"], "order_by": [{"field": "net_pnl", "direction": "asc"}], "limit": 1}}
{"id": "sm-13", "category": "smart", "source": "metric-11", "question": "Compare my win rate on gold versus EURUSD.", "gold": {"entity": "trades", "metrics": ["win_rate"], "compare": [{"label": "Gold", "filters": [{"field": "canonical_symbol", "op": "eq", "value": "XAUUSD"}]}, {"label": "EURUSD", "filters": [{"field": "canonical_symbol", "op": "eq", "value": "EURUSD"}]}]}}
{"id": "sm-14", "category": "smart", "source": "metric-09", "question": "What is my maximum drawdown?", "gold": {"entity": "trades", "metrics": ["max_drawdown"]}}
{"id": "sm-15", "category": "smart", "source": "exp-01", "question": "How many lots did I have open at once at the peak, and when?", "gold": {"entity": "exposure", "fields": ["time_utc", "gross_lots"], "filters": [{"field": "symbol", "op": "eq", "value": "ALL"}], "order_by": [{"field": "gross_lots", "direction": "desc"}, {"field": "time_utc", "direction": "asc"}], "limit": 1}}
{"id": "sm-16", "category": "smart", "source": "ho-metric-07", "question": "What was my win rate from 14 to 20 September 2026?", "gold": {"entity": "trades", "time_range": {"start": "2026-09-14", "end": "2026-09-20"}, "metrics": ["win_rate"]}}
