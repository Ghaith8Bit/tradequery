# Copy to .env (git-ignored) and fill in. Use the INVESTOR (read-only) password,
# never the master password. It can read history but cannot trade.
# The server name must match the broker's MT5 server exactly (e.g. "Broker-Live01").
MT5_LOGIN=
MT5_INVESTOR_PASSWORD=
MT5_SERVER=

# Optional. Your broker's MT5 installer (release build + its server list), used by
# make mt5-setup. Without it the generic MetaQuotes installer is used. Example:
# MT5_INSTALLER_URL=https://download.mql5.com/cdn/web/vt.markets.pty/mt5/vtmarkets5setup.exe
# Optional. Terminal folder under C:\Program Files to use, if several are installed.
# MT5_TERMINAL_DIR=VT Markets (Pty) MT5 Terminal
# Optional. The sync worker (started by make web) also syncs on this timer; 0 or unset = only "Sync now".
# SYNC_EVERY_MINUTES=60

# Asking questions in plain English (make ask). A Gemini API key from Google AI Studio
# ("Get API key"). Optional: GEMINI_MODEL picks a model; without it the newest
# Flash-Lite model your key can use is chosen (see: docker compose run --rm app llm-models).
# Note: on the free tier Google may use prompts to improve its products. Trade comments
# and credentials are never sent; questions, the schema and result tables are.
GEMINI_API_KEY=
# GEMINI_MODEL=

# Optional cost limits for the page: AI requests and tokens per UTC day (0 = no limit),
# and TQ_EXPLAIN=ai to have the model write every answer (default auto: code writes simple ones).
# TQ_DAILY_REQUESTS=300
# TQ_DAILY_TOKENS=1000000
# TQ_EXPLAIN=auto

# Optional: open the page to other devices on a network you trust (e.g. your phone on home Wi-Fi).
# All three are needed; the page refuses to start with TQ_ALLOWED_HOSTS set and no password.
# TQ_BIND=0.0.0.0
# TQ_ALLOWED_HOSTS=192.168.1.20        # this computer's address or name, as the phone types it
# TQ_PASSWORD=                         # at least 10 characters
